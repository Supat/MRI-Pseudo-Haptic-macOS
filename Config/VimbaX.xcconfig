//
//  VimbaX.xcconfig
//
//  Points the build system at your local Vimba X SDK installation.
//
//  The Vimba X SDK for macOS is distributed as a .dmg disk image:
//  mount the DMG, drag the VimbaX folder out of it to wherever you
//  want the SDK to live, then point VIMBA_X_HOME below at that folder.
//
//  The expected directory layout inside $(VIMBA_X_HOME) is:
//
//      $(VIMBA_X_HOME)/
//          api/
//              include/
//                  VmbC/VmbC.h
//                  VmbImageTransform/VmbTransform.h
//              lib/
//                  libVmbC.dylib
//                  libVmbImageTransform.dylib
//              ...
//          cti/
//              ...   (GenTL transport layers, required at runtime)
//
//  Option 1 — vendor the SDK next to the project (default):
//
//      hdiutil attach ~/Downloads/VimbaX_Setup-<version>-macOS.dmg
//      mkdir -p ThirdParty
//      cp -R /Volumes/VimbaX*/VimbaX* ThirdParty/VimbaX
//      hdiutil detach /Volumes/VimbaX*
//      xattr -dr com.apple.quarantine ThirdParty/VimbaX
//
//  Option 2 — drag the VimbaX folder into /Applications and point at it:
//
//      VIMBA_X_HOME = /Applications/VimbaX
//
//  Option 3 — keep it under $HOME:
//
//      VIMBA_X_HOME = $(HOME)/VimbaX
//
//  Option 4 — hand-set an absolute path:
//
//      VIMBA_X_HOME = /opt/VimbaX
//

VIMBA_X_HOME = $(PROJECT_DIR)/ThirdParty/VimbaX

HEADER_SEARCH_PATHS = $(inherited) $(VIMBA_X_HOME)/api/include
LIBRARY_SEARCH_PATHS = $(inherited) $(VIMBA_X_HOME)/api/lib
OTHER_LDFLAGS = $(inherited) -lVmbC -lVmbImageTransform

// Ensure the Vimba C dylibs (and the CTI transport layers they load at
// runtime) can be found after launch. The CTI loader honours the
// GENICAM_GENTL64_PATH environment variable; see README for how to
// propagate it into the Xcode run action.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks $(VIMBA_X_HOME)/api/lib
